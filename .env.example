# ==================== ОБЯЗАТЕЛЬНЫЕ ====================

# Токен бота (получить у @BotFather)
BOT_TOKEN=

# Юзернейм бота (без @) — используется в разделе "Помощь"
BOT_USERNAME=your_bot_username

# ==================== БАЗА ДАННЫХ ====================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=bot_4_tempmail
DB_USER=bot_4_tempmail
DB_PASSWORD=

# ==================== АДМИНЫ ====================

# Telegram ID админов через запятую
ADMIN_IDS=
ADMIN_USERNAME=admin

# ==================== ОПЦИОНАЛЬНО ====================

# Кэш (дни) — зарезервировано на будущее
CACHE_TTL_DAYS=1

# URL Bot API (оставить по умолчанию — tempmail не работает с большими файлами)
# BOT_API_URL=https://api.telegram.org

# API_ID и API_HASH нужны только если используется Local Bot API (файлы > 50 МБ)
# Для tempmail-бота НЕ нужны.
# API_ID=
# API_HASH=
